<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>twist2_neck_ros2</name>
  <version>0.0.0</version>
  <description>Package for TWIST2 Neck XR teleoperation. Contains drivers and launchfile.</description>
  <maintainer email="humansbadrobotsgood@gmail.com">Tomico-DEV</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>isaac_teleop_core</exec_depend>
  <exec_depend>isaac_ros_teleop</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
